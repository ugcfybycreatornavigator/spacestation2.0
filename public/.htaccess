RewriteEngine On

# Keep non-production hostnames out of search results.
<IfModule mod_headers.c>
  SetEnvIfNoCase Host "^(?!spacestationcoworking\.com$).+" NON_CANONICAL_HOST
  Header always set X-Robots-Tag "noindex, nofollow" env=NON_CANONICAL_HOST
</IfModule>

# One-hop redirect for HTTP and every alternate hostname.
RewriteCond %{HTTPS} !=on [OR]
RewriteCond %{HTTP_HOST} !^spacestationcoworking\.com$ [NC]
RewriteRule ^ https://spacestationcoworking.com%{REQUEST_URI} [R=301,L,NE]

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
